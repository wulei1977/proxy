# 配置模板。复制为 .env 后按需填写。

# 监听与连接
GOPROXY_LISTEN=127.0.0.1:8080
GOPROXY_MAX_CONNECTIONS=256

# 用户名和密码留空时不启用认证；启用时请同时填写。
GOPROXY_USER=
GOPROXY_PASS=

# 自定义 TLS 证书和私钥；同时留空时使用临时自签名证书。
GOPROXY_CERT=
GOPROXY_KEY=

# 超时
GOPROXY_DIAL_TIMEOUT=10s
GOPROXY_REQUEST_READ_TIMEOUT=15s
GOPROXY_RESPONSE_HEADER_TIMEOUT=15s
GOPROXY_UPSTREAM_WRITE_TIMEOUT=15s
GOPROXY_CLIENT_WRITE_TIMEOUT=15s
GOPROXY_RESPONSE_BODY_IDLE_TIMEOUT=60s
GOPROXY_TUNNEL_HALF_CLOSE_TIMEOUT=60s
GOPROXY_TUNNEL_WRITE_TIMEOUT=15s

# 请求日志
GOPROXY_V=false
